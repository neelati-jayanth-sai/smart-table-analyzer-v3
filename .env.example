# Smart Table Analyzer — local development environment
# Copy this file to `.env` and adjust values if needed.
# `.env` is gitignored; never commit real credentials or tokens.

# ---------------------------------------------------------------------------
# Common runtime settings
# ---------------------------------------------------------------------------
STA_ENV=local
STA_DB_PATH=./sta.sqlite3
STA_KNOWLEDGE_PATH=./knowledge
STA_MAX_CONCURRENT_RUNS=2
STA_QUERY_TIMEOUT=30

# ---------------------------------------------------------------------------
# Local Iceberg REST catalog (docker-compose.yml exposes this on localhost)
# ---------------------------------------------------------------------------
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://sta-warehouse/
ICEBERG_CATALOG_NAME=local

# ---------------------------------------------------------------------------
# Local S3-compatible object storage (MinIO from docker-compose.yml)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true

# ---------------------------------------------------------------------------
# Investigator model (Ollama Cloud, exactly gpt-oss:120b-cloud)
# ---------------------------------------------------------------------------
# The Pydantic AI investigator uses Ollama Cloud's native /api/chat API with
# the model pinned to gpt-oss:120b-cloud. An API key enables it automatically:
# OLLAMA_API_KEY is the current name; LOCAL_OLAMMA_API_KEY is accepted as a
# legacy alias. Default endpoint: https://ollama.com/api/chat (Ollama Cloud).
# The key is a secret: never logged, stored in events/results, or sent to
# the model.
OLLAMA_API_KEY=

# Optional: point the investigator at an explicitly set local Ollama daemon
# instead of Ollama Cloud (no fallback provider/model exists). Naming differs
# by design: "-cloud" is an Ollama-Cloud-hosted tag, so a local daemon keeps
# the local gpt-oss:120b tag — the same Ollama gpt-oss 120b model, never
# another vendor/model.
# OLLAMA_BASE_URL=http://localhost:11434/v1